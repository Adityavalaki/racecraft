.venv/
__pycache__/
*.egg-info/
.pytest_cache/
data/
web/node_modules/
web/dist/

# Packaging output: the frozen app, the MSIX, and signing material. The .pfx is
# a private key and must never be committed; the generated tile assets are built
# from the icon by make_msix_assets.py.
dist/
build/
packaging/msix/*.pfx
packaging/msix/*.cer
packaging/msix/Assets/

# Packaging tools fetched from NuGet by build_msix.ps1
packaging/.tools/

# Kept on the maintainer's machine, not published: the working notes behind the
# project (handover, decisions, assumptions, backlog, rollback, bug and feature
# write-ups), the validation scripts that re-check the figures in TECHNICAL.md,
# the write-ups of the earlier projects, and editor settings.
docs/HANDOVER.md
docs/ASSUMPTIONS.md
docs/BACKLOG.md
docs/DECISIONS.md
docs/ROLLBACK.md
docs/bugs/
docs/features/
docs/defense/
legacy/
.vscode/
scripts/*
!scripts/backfill.ps1
!scripts/make_icon.py
